{
  "name": "adlib-live",
  "version": "0.1.0",
  "private": true,
  "description": "adlib \u2014 the AI hype man. Build a beat, rap, and he backs you up. Live at adlib.live",
  "scripts": {
    "generate": "node scripts/generate-audio.js",
    "generate:hype": "node scripts/generate-audio.js --mode hype",
    "generate:boom": "node scripts/generate-audio.js --mode boom",
    "generate:force": "node scripts/generate-audio.js --force",
    "dev": "npx serve public -l 3000",
    "deploy": "vercel --prod",
    "test": "node test/logic.test.mjs",
    "build:rhymes": "node scripts/build-rhymes.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
