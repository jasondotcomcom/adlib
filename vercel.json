{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/testdj/audio/:p*",
      "destination": "/audio/:p*"
    },
    {
      "source": "/testdj/fonts/:p*",
      "destination": "/fonts/:p*"
    },
    {
      "source": "/testdj/data/:p*",
      "destination": "/data/:p*"
    },
    {
      "source": "/testdj",
      "destination": "/testdj/index"
    },
    {
      "source": "/testdj/classic",
      "destination": "/classic"
    },
    {
      "source": "/testdj/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/testdj/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/testdj/apple-touch-icon.png",
      "destination": "/apple-touch-icon.png"
    },
    {
      "source": "/testdj/og.png",
      "destination": "/og.png"
    }
  ],
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sweep",
      "schedule": "0 11 * * *"
    }
  ]
}
